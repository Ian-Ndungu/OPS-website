DATABASE_URL=postgresql+psycopg2://ops:ops@localhost:5432/ops_esports
SECRET_KEY=generate-a-long-random-string
CORS_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=https://your-domain.example
CALLBACK_SECRET=generate-another-long-random-string

# Payments: sandbox by default. Live money stays OFF until all three are set deliberately.
DARAJA_ENV=sandbox
LIVE_PAYMENTS_ENABLED=false
COMPLIANCE_SIGNOFF_REF=
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
DARAJA_INITIATOR_NAME=
DARAJA_SECURITY_CREDENTIAL=

# Optional email for announcements
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=OPS Esports <no-reply@your-domain.example>
